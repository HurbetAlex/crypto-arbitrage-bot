# Telegram alerts (create a bot with @BotFather; chat id from @userinfobot or the Bot API)
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# Comma-separated venues as exchange:market (market is spot or future)
VENUES=binance:spot,binance:future,bybit:spot,bybit:future,kucoin:spot,kucoin:future

# Include DexScreener quotes (off by default: same-ticker tokens can be unrelated assets)
ENABLE_DEX=false

# Signal filters
TRADE_VOLUME_USDT=1000
MIN_PROFIT_PCT=2.0
MAX_PROFIT_PCT=200.0
MIN_VOLUME_USDT=0
ALERT_COOLDOWN_SECONDS=900

# Fees as fractions (0.001 = 0.1%)
DEFAULT_FEE_RATE=0.001
DEX_FEE_RATE=0.003
# Per-venue override as JSON, e.g. {"bybit:spot": 0.0008}
FEE_OVERRIDES={}

# Polling
POLL_INTERVAL_SECONDS=10
REQUEST_TIMEOUT_MS=10000
# 0 = run forever; N = stop after N cycles
MAX_CYCLES=0
# If true, print alerts to stdout instead of sending them to Telegram
DRY_RUN=true
